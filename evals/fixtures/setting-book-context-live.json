  "grading_policy": {
    "primary": "Semantic SETTING atoms from source. CHARACTER_DISCOVERY is separate.",
    "S9": "Observe mother recovery, accepting relative title or unresolved subject; exact prior status key is a separate stricter continuity diagnostic.",
    "S7": "Require distinct current-recovering and unrealized-future-recovery settings.",
    "selection": "expected_selection lists catalogue names whose CURRENT the stage-1 selection must send; a superset is acceptable (recall first), a missing expected name is a selection miss. expected_unmatched lists new-person mentions that must not be linked to any catalogue ref.",
    "indirect": "S13/S14/S19/S20 subjects are referenced by title, kinship or pronoun only; the candidate may name the catalogue character, the relational expression, or an unresolved subject."
  }
