# Container image
AI_IMAGE=ghcr.io/catchhole-soma/catchhole-backend-ai:sha-replace-with-published-short-sha

# Shared runtime timezone
APP_TIMEZONE=Asia/Seoul

# External Amazon RDS for PostgreSQL
# Percent-encode reserved characters in the username or password before putting them in this URL.
DATABASE_URL=postgresql+psycopg://catchhole_admin:replace-with-url-encoded-password@replace-with-rds-endpoint:5432/catchhole?sslmode=require
DATABASE_POOL_SIZE=3
DATABASE_POOL_MAX_OVERFLOW=0

# AWS and Amazon S3; the EC2 instance role supplies credentials.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=catchhole-dev-037077640960-ap-northeast-2-an
AWS_SQS_QUEUE_URL=

# Spring internal API on the API EC2 private address
SPRING_INTERNAL_API_BASE_URL=http://replace-with-api-private-ip:8080
SPRING_INTERNAL_API_KEY=replace-with-the-same-internal-api-key-as-the-api-server
# Analysis state API read wait; heartbeat/token ledger and connect/write/pool stay at 30s.
SPRING_WORKER_READ_TIMEOUT_SECONDS=120

# LLM
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-5.6-terra
LLM_EXTRACTION_MODEL=gpt-5.6-terra
LLM_SUBJECT_RESOLUTION_MODEL=gpt-5.6-luna
LLM_COMPARISON_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=medium
LLM_SETTING_EXTRACTION_MAX_OUTPUT_TOKENS=32000
LLM_SETTING_EXTRACTION_RETRY_MAX_OUTPUT_TOKENS=64000
LLM_WORLD_SETTING_EXTRACTION_MAX_OUTPUT_TOKENS=32000
LLM_WORLD_SETTING_EXTRACTION_RETRY_MAX_OUTPUT_TOKENS=64000
LLM_SUBJECT_RESOLUTION_MAX_OUTPUT_TOKENS=2000
LLM_COMPARISON_MAX_OUTPUT_TOKENS=3000
LLM_CHARACTER_FACT_BATCH_COMPARISON_MAX_OUTPUT_TOKENS=128000
LLM_CHARACTER_FACT_BATCH_COMPARISON_MAX_INPUT_TOKENS=256000
LLM_WORLD_SETTING_BATCH_COMPARISON_MAX_OUTPUT_TOKENS=16000
LLM_WORLD_SETTING_BATCH_COMPARISON_MAX_INPUT_TOKENS=64000
LLM_PROVIDER_MAX_OUTPUT_TOKENS=128000
OPENAI_RESPONSES_API_URL=https://api.openai.com/v1/responses
LLM_HTTP_MAX_RETRIES=3
LLM_HTTP_RETRY_BASE_SECONDS=2
EMBEDDING_GENERATION_ENABLED=false

# 5 analysis Worker containers x 10 concurrent jobs = 50 SETTING_EXTRACTION slots
AI_WORKER_PROCESS_COUNT=5
AI_WORKER_CONCURRENCY=10
LLM_MAX_CONCURRENT_REQUESTS=10
AI_WORKER_BLOCKING_MAX_WORKERS=3
AI_WORKER_IDLE_SLEEP_SECONDS=5
AI_WORKER_SHUTDOWN_GRACE_SECONDS=180

# 검수 Worker(ai-validation-worker, #344): 기본 0개로 꺼져 있다.
# 켜기 전에 API 서버 api.env의 VALIDATION_EXECUTION_ENABLED와 검수 예산 JSON(SPRING_APPLICATION_JSON)을 먼저 적용한다.
# S3·metrics·tracing은 쓰지 않고 위 SPRING_INTERNAL_API_*와 LLM_API_KEY를 분석 Worker와 공유한다.
# DB는 아래 VALIDATION_READONLY_DATABASE_URL을 채울 때만 읽기 전용으로 쓴다.
# provider 동시 요청은 분석 50(5×10) + 비교 2 + 검수 프로세스 수 × VALIDATION_WORKER_LLM_CONCURRENCY의 합이다.
VALIDATION_WORKER_PROCESS_COUNT=0
# 프로세스당 동시 검수 Job 수와 프로세스 전체 LLM 요청 상한
VALIDATION_WORKER_CONCURRENCY=3
VALIDATION_WORKER_LLM_CONCURRENCY=4
# claim 시도 사이 간격(초). 연속 실패 시 최대 60초까지 늘어난다.
VALIDATION_WORKER_POLL_SECONDS=5
# 선택: claim에 보내는 workerId. 생략하면 validation-prod. 여러 프로세스가 같은 값을 써도 lease token은 Job별로 발급된다.
# VALIDATION_WORKER_ID=validation-prod
# 선택: 과거 원고 의미(벡터) 검색. 비워 두면 키워드 검색만 쓴다(로그 `frozen retrieval disabled`).
# 켤 때는 chatbot.env의 CHAT_RETRIEVAL_DATABASE_URL과 같은 SELECT 전용 계정 URL을 그대로 넣는다.
# 프로세스마다 DB 연결 VALIDATION_WORKER_CONCURRENCY개를 더 쓰므로 retrieval.env의 AI_RUNTIME_DB_CONNECTION_BUDGET에 포함한다.
# API 검수 예산 JSON에 QUERY_EMBEDDING 역할이 없으면 URL이 있어도 Job마다 키워드 검색만 제안한다.
VALIDATION_READONLY_DATABASE_URL=
# 색인 버전. chatbot.env의 CHAT_RETRIEVAL_EMBEDDING_VERSION과 같아야 한다.
VALIDATION_WORKER_INDEX_VERSION=v1

# Worker metrics: 처음에는 localhost. 모니터링 SG 허용 뒤 EC2 사설 IPv4로 변경.
AI_WORKER_METRICS_ENABLED=true
AI_WORKER_METRICS_BIND_ADDRESS=127.0.0.1
# 분석 replica마다 범위 내 서로 다른 실제 host port를 할당한다.
AI_WORKER_METRICS_PORT_RANGE=9102-9106

# Worker tracing: explicit opt-in after private Collector/Spring rollout checks.
# Applies to analysis, character-comparison, and world-comparison workers.
# Keep the endpoint empty while OFF. When enabling, set the monitoring EC2's
# RFC1918 IPv4: http://<MONITORING_PRIVATE_IPV4>:4318/v1/traces
# This is an outbound push; no extra Worker host port is published.
AI_WORKER_TRACING_ENABLED=false
# Optional per-service overrides. If omitted/empty, use the common flag above.
# First canary: character-comparison=true, common/analysis/world=false.
# AI_ANALYSIS_TRACING_ENABLED=false
# AI_CHARACTER_COMPARISON_TRACING_ENABLED=true
# AI_WORLD_COMPARISON_TRACING_ENABLED=false
OTEL_SERVICE_NAME=catchhole-ai-worker
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# SDK policy is fixed in app/monitoring/worker_tracing.py:
# parent-based all-on; queue 1024 spans/process; batch 256; interval 1s; timeout 5s.
# No OTEL_BSP_* setting here: the runtime passes explicit limits.

# Prepare separate 800/100-token retrieval slices; operator indexing generates vectors.
RETRIEVAL_PREPARATION_ENABLED=false
