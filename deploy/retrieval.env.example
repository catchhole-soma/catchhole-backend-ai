# Loaded after worker.env. Inherits DATABASE_URL/S3/internal API/provider credentials.
# These settings must be configured once before automatic runtime deployment.
RETRIEVAL_BACKFILL_ENABLED=false
RETRIEVAL_EMBEDDING_GENERATION_ENABLED=false
# Stable across deploys/restarts. Changing this ID creates a NEW budget; never use a SHA/date.
RETRIEVAL_BACKFILL_ID=retrieval-v1-rollout
# Required when enabled. Cumulative conservative input allowance, not a per-run allowance.
RETRIEVAL_BACKFILL_MAX_INPUT_TOKENS=
# Choose exactly one: active-works or an explicit comma-separated UUID list.
RETRIEVAL_BACKFILL_SCOPE=active-works
RETRIEVAL_BACKFILL_WORK_IDS=
RETRIEVAL_BACKFILL_ACTOR=scheduled-retrieval
RETRIEVAL_BACKFILL_MAX_SECONDS=300
RETRIEVAL_BACKFILL_PAGE_SIZE=100
RETRIEVAL_BACKFILL_MAX_CHUNKS=1000
RETRIEVAL_BACKFILL_BATCH_SIZE=8
RETRIEVAL_BACKFILL_MAX_RETRIES=1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=v1
# Confirm actual RDS capacity and other clients first. Defaults require 31 steady-state
# app connections (API10 + analysis5*3 + comparisons2 + chat2 + index2), plus one deployment probe (32 total) and separate admin headroom.
AI_RUNTIME_API_DB_POOL_SIZE=10
AI_RUNTIME_DB_CONNECTION_BUDGET=
