# Separate chat process. Use an immutable image containing GH238.
AI_IMAGE=ghcr.io/catchhole-soma/catchhole-backend-ai:sha-replace-with-published-short-sha
SPRING_INTERNAL_API_BASE_URL=http://replace-with-api-private-ip:8080
SPRING_INTERNAL_API_KEY=replace-with-existing-internal-api-key
CHAT_BIND_ADDRESS=127.0.0.1
CHAT_CAPACITY=4
CHAT_CPUS=0.5
CHAT_MEMORY=512m

# Explicit opt-in after model quality and operational verification.
# Spring CHAT_ENABLED is an independent gate. This file does not deploy the service.
CHAT_QA_ENABLED=false
LLM_API_KEY=
CHAT_QA_MODEL=gpt-5.6-terra
CHAT_QA_REASONING_EFFORT=medium
CHAT_QA_MAX_ATTEMPTS=2
CHAT_QA_MAX_OUTPUT_TOKENS=1500
CHAT_QA_MAX_INPUT_TOKENS=8000
CHAT_QA_MAX_CONTEXT_CHARACTERS=24000
CHAT_QA_PAGE_SIZE=20
CHAT_QA_MAX_PAGES=2
CHAT_QA_MAX_ITEMS=80
CHAT_QA_MAX_TOOL_CALLS=16
CHAT_QA_MAX_SELECTED_ROWS=10
CHAT_QA_MAX_EVIDENCE_CALLS=8
CHAT_QA_MAX_ANSWER_CHARACTERS=12000
